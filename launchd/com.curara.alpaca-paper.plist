<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.curara.alpaca-paper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/curara/trading/ft_env/bin/python3</string>
        <string>/Users/curara/trading/scripts/alpaca_paper_bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/curara/trading</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TRADING_ROOT</key>
        <string>/Users/curara/trading</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>ALPACA_DOLLARS_PER_TRADE</key>
        <string>100</string>
        <key>ALPACA_MAX_POSITIONS</key>
        <string>10</string>
        <key>ALPACA_MIN_CONF_BUY</key>
        <string>0.6</string>
        <key>ALPACA_MIN_CONF_SELL</key>
        <string>0.55</string>
        <key>ALPACA_ANALYZE_PER_CYCLE</key>
        <string>8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>NetworkState</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/curara/trading/logs/alpaca_paper_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/curara/trading/logs/alpaca_paper_stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>
